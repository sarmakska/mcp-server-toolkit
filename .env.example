# Transport: stdio (local agents) or http (remote deployment)
MCP_TRANSPORT=stdio
MCP_HTTP_HOST=0.0.0.0
MCP_HTTP_PORT=8000

# Auth: none | api_key | oauth
MCP_AUTH=none

# API key auth (MCP_AUTH=api_key). Generate with: openssl rand -hex 32
MCP_API_KEY=

# OAuth 2.1 resource server (MCP_AUTH=oauth)
MCP_OAUTH_ISSUER=
MCP_OAUTH_AUDIENCE=
# Optional: skip discovery by pointing straight at the JWKS endpoint
MCP_OAUTH_JWKS_URI=

# OAuth client flow used by `mcp-toolkit login`
MCP_OAUTH_CLIENT_ID=
MCP_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
MCP_OAUTH_SCOPE=openid profile

# Per-client rate limiting on the HTTP transport. 0 disables it.
MCP_RATE_LIMIT_RPS=0
MCP_RATE_LIMIT_BURST=0

# Filesystem plugin sandbox root
MCP_FS_ROOT=

# SarmaLink-AI plugin
MCP_SARMALINK_API_KEY=
MCP_SARMALINK_BASE_URL=https://api.sarmalink.ai/v1

# Observability: set an OTLP collector endpoint to export tool-call spans
MCP_OTEL_ENDPOINT=
MCP_SERVICE_NAME=mcp-server-toolkit
